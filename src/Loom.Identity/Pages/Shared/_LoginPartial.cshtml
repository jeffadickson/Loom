<ul class="navbar-nav">
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item"><a class="nav-link text-dark" href="/Identity/Account/Manage">My account</a></li>
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item"><a class="nav-link text-dark" href="/accounts.html">Accounts</a></li>
    }
    <li class="nav-item"><form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button type="submit" class="nav-link btn btn-link text-dark">Sign out</button></form></li>
}
else
{
    <li class="nav-item"><a class="nav-link text-dark" href="/Identity/Account/Login">Sign in</a></li>
}
</ul>
